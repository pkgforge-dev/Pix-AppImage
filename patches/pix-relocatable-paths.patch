+ *  along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef PIX_PREFIX_H
+#define PIX_PREFIX_H
+
+#include <glib.h>
+#include <config.h>
+
+/* The data and module directories are normally baked in at build time (see
+ * the PIX_*_DIR defines in config.h).  Resolve them against $APPDIR when it
+ * is set, so that the same build works both installed in a normal prefix and
+ * relocated, for example inside an AppImage. */
+
+static inline const char *
+pix_get_prefix (void)
+{
+	static const char *prefix = NULL;
+
+	if (prefix == NULL) {
+		const char *appdir = g_getenv ("APPDIR");
+		prefix = (appdir != NULL && appdir[0] == '/') ? appdir : PIX_PREFIX;
+	}
+
+	return prefix;
+}
+
+static inline const char *
+pix_get_libexec_dir (void)
+{
+	static char *dir = NULL;
+
+	if (dir == NULL)
+		dir = g_build_filename (pix_get_prefix (), "lib", "pix", NULL);
+
+	return dir;
+}
+
+static inline const char *
+pix_get_pkgdata_dir (void)
+{
+	static char *dir = NULL;
+
+	if (dir == NULL)
+		dir = g_build_filename (pix_get_prefix (), "share", "pix", NULL);
+
+	return dir;
+}
+
+static inline const char *
+pix_get_ui_dir (void)
+{
+	static char *dir = NULL;
+
+	if (dir == NULL)
+		dir = g_build_filename (pix_get_pkgdata_dir (), "ui", NULL);
+
+	return dir;
+}
+
+static inline const char *
+pix_get_icon_dir (void)
+{
+	static char *dir = NULL;
+
+	if (dir == NULL)
+		dir = g_build_filename (pix_get_pkgdata_dir (), "icons", NULL);
+
+	return dir;
+}
+
+static inline const char *
+pix_get_extensions_dir (void)
+{
+	static char *dir = NULL;
+
+	if (dir == NULL)
+		dir = g_build_filename (pix_get_libexec_dir (), "extensions", NULL);
+
+	return dir;
+}
+
+#endif /* PIX_PREFIX_H */
